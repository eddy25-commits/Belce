# Relative by default — correct when frontend + backend deploy together as
# one Vercel project (same origin) and for local dev (proxied by vite.config.js).
# Only override this with an absolute URL if the backend is ever hosted separately.
VITE_API_URL=/api

# Supabase project settings — from your Supabase dashboard:
# Project Settings -> API. Only the URL and the public "anon" key go here;
# never put the service_role key in frontend code.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key
