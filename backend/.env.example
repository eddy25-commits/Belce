# Server
PORT=5000
NODE_ENV=development

# Supabase project settings — from your Supabase dashboard:
# Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key
# Service role key — SECRET. Full admin access, bypasses Row Level Security.
# Never expose this to the frontend or commit it to Git.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# CORS - only needed if the backend is ever hosted on a different domain
# than the frontend (it isn't, in the default single-Vercel-project setup).
# Leave unset for local dev (Vite proxies /api) and for the unified deploy.
# CLIENT_ORIGIN=https://your-frontend-domain.com

# Paystack - https://dashboard.paystack.com/#/settings/developers
# Use your real secret key in a local .env file only; never commit it to Git.
PAYSTACK_SECRET_KEY=replace_with_your_paystack_secret_key
# Same domain as your deployed site, since frontend + backend are one project
PAYSTACK_CALLBACK_URL=https://your-domain.vercel.app/payment/callback

# Used only once, by scripts/seedAdmin.js, to create the first admin login
ADMIN_NAME=Belce Admin
ADMIN_EMAIL=admin@belce.com
ADMIN_PASSWORD=change_this_password
